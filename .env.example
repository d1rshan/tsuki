# Local development only. Copy to .env, or let `bun run setup` create it.
# Docker DB/proxy URLs and localhost ports are supplied by scripts/environment.ts.
# Production DB credentials belong in .secrets/neon.env, never here.
BETTER_AUTH_SECRET=

# Optional service credentials. Use development credentials where available.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_GIPHY_BIO_KEY=
NEXT_PUBLIC_GIPHY_REVIEW_KEY=
SYNC_SECRET=
