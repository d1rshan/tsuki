DATABASE_URL=
BETTER_AUTH_SECRET=
# Shared secret for /admin/sync/* endpoints (POST tick sends x-sync-secret).
# For Vercel cron: set the CRON_SECRET env var on the deployment to this same
# value — cron requests then arrive with `Authorization: Bearer <SYNC_SECRET>`.
# The nightly cron runs an incremental walk (media updated since the last
# pass); a full bootstrap crawl is manual, via scripts/sync-bootstrap.ts.
SYNC_SECRET=
RESEND_API_KEY=
# Example: Tsuki <auth@your-verified-domain.com>
RESEND_FROM_EMAIL=
# Optional: profile avatar/banner uploads via ImageKit (disabled when unset)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
# Optional: only needed for custom ImageKit URL endpoints
IMAGEKIT_URL_ENDPOINT=
