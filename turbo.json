{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "//#lint:check": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format:check": {},
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "env": [
        "DATABASE_URL"
      ],
      "cache": false
    },
    "db:studio": {
      "cache": false
    }
  }
}
