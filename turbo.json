{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "LOCAL_DATABASE_HTTP_ENDPOINT",
    "BETTER_AUTH_SECRET",
    "SYNC_SECRET",
    "IMAGEKIT_PRIVATE_KEY",
    "IMAGEKIT_PUBLIC_KEY",
    "IMAGEKIT_URL_ENDPOINT",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NODE_ENV",
    "CI",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SYNC_CRON_BUDGET_MS",
    "CRON_SECRET",
    "NEXT_PUBLIC_GIPHY_BIO_KEY",
    "NEXT_PUBLIC_GIPHY_REVIEW_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "GOOGLE_SITE_VERIFICATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "//#lint:check": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format:check": {},
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "env": ["DATABASE_URL"],
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false
    }
  }
}
