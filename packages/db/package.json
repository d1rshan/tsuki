{
  "name": "@tsuki/db",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "db:push": "bun --no-env-file ../../scripts/run.ts db:push",
    "db:cleanup-activity": "bun --no-env-file ../../scripts/run.ts db:cleanup-activity",
    "db:studio": "bun --no-env-file ../../scripts/run.ts db:studio",
    "typecheck": "tsc --noEmit",
    "db:push:prod": "bun --no-env-file ../../scripts/run.ts db:push:prod",
    "db:studio:prod": "bun --no-env-file ../../scripts/run.ts db:studio:prod",
    "db:cleanup-activity:prod": "bun --no-env-file ../../scripts/run.ts db:cleanup-activity:prod"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tsuki/env": "workspace:*",
    "@tsuki/rich-content": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "0.31.11",
    "pg": "^8.23.1"
