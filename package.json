{
  "name": "tsuki",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "tailscale": "TSUKI_TAILSCALE_IP=$(tailscale ip -4) && test -n \"$TSUKI_TAILSCALE_IP\" && echo \"Open http://$TSUKI_TAILSCALE_IP:3000 on your phone\" && NEXT_PUBLIC_APP_URL=http://$TSUKI_TAILSCALE_IP:3000 NEXT_PUBLIC_API_URL=http://localhost:3001 bun run dev",
    "local:setup": "bun run scripts/local.ts setup",
    "local:up": "bun run scripts/local.ts up",
    "local:sync": "bun run scripts/local.ts sync",
    "local:snapshot": "bun run scripts/local.ts snapshot",
    "local:stop": "bun run scripts/local.ts stop",
    "start": "turbo run start",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deploy": "bun run deploy:check && bun run deploy:web && bun run deploy:api",
    "deploy:check": "bun run build && bun run typecheck",
    "deploy:web": "npx vercel --project tsuki-web --prod",
    "deploy:api": "npx vercel --project tsuki-api --prod",
    "db:push": "turbo -F @tsuki/db db:push",
    "db:studio": "turbo -F @tsuki/db db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,md,css}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "drizzle-kit@0.31.10": "patches/drizzle-kit@0.31.10.patch"
  }
}
