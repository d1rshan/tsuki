{
  "name": "tsuki",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate:themes": "turbo run generate:themes --filter=web",
    "deploy": "bun run deploy:check && bun run deploy:web && bun run deploy:api",
    "deploy:check": "bun run build && bun run typecheck",
    "deploy:web": "vercel --project tsuki-web --prod",
    "deploy:api": "vercel --project tsuki-api --prod",
    "db:push": "turbo -F @tsuki/db db:push",
    "db:studio": "turbo -F @tsuki/db db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.69.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,md,css}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "drizzle-kit@0.31.10": "patches/drizzle-kit@0.31.10.patch"
  }
}
