{
  "name": "tsuki",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo -F @tsuki/db db:push",
    "db:studio": "turbo -F @tsuki/db db:studio",
    "sync:trending": "bun run apps/api/src/scripts/sync-trending.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.13"
}
