{
  "name": "tsuki",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo -F @tsuki/db db:push",
    "db:studio": "turbo -F @tsuki/db db:studio"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13"
}
