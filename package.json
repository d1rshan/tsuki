{
  "name": "tsuki",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --no-env-file scripts/run.ts build",
    "dev": "bun --no-env-file scripts/run.ts dev",
    "tailscale": "bun --no-env-file scripts/run.ts dev:mobile",
    "local:setup": "bun --no-env-file scripts/run.ts setup",
    "local:up": "bun --no-env-file scripts/run.ts local:up",
    "local:sync": "bun --no-env-file scripts/run.ts catalog:sync",
    "local:snapshot": "bun --no-env-file scripts/run.ts catalog:snapshot",
    "local:stop": "bun --no-env-file scripts/run.ts local:stop",
    "start": "bun --no-env-file scripts/run.ts start",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun run test:env && turbo run test",
    "deploy": "bun run deploy:check && bun run deploy:web && bun run deploy:api",
    "deploy:check": "bun run build && bun run typecheck",
    "deploy:web": "npx vercel --project tsuki-web --prod",
    "deploy:api": "npx vercel --project tsuki-api --prod",
    "db:push": "bun --no-env-file scripts/run.ts db:push",
    "db:studio": "bun --no-env-file scripts/run.ts db:studio",
    "prepare": "husky",
    "setup": "bun --no-env-file scripts/run.ts setup",
    "dev:mobile": "bun --no-env-file scripts/run.ts dev:mobile",
    "catalog:sync": "bun --no-env-file scripts/run.ts catalog:sync",
    "catalog:snapshot": "bun --no-env-file scripts/run.ts catalog:snapshot",
    "env:check": "bun --no-env-file scripts/run.ts env:check",
    "env:check:prod": "bun --no-env-file scripts/run.ts env:check:prod",
    "db:push:prod": "bun --no-env-file scripts/run.ts db:push:prod",
    "db:studio:prod": "bun --no-env-file scripts/run.ts db:studio:prod",
    "db:cleanup-activity": "bun --no-env-file scripts/run.ts db:cleanup-activity",
    "db:cleanup-activity:prod": "bun --no-env-file scripts/run.ts db:cleanup-activity:prod",
    "test:env": "bun test scripts/environment.test.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,md,css}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "drizzle-kit@0.31.10": "patches/drizzle-kit@0.31.10.patch"
  }
}
